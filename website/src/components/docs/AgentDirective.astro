---
import { translate } from '../../i18n';

interface Props { markdownUrl: string; llmsUrl: string }
const { markdownUrl, llmsUrl } = Astro.props;
const t = translate(Astro.locals.docsLocale);
---
<aside class="sr-only" aria-label={t('docs.forAgents')} data-ai-agent-directive data-pagefind-ignore>
  <p>{t('docs.agentFormats')}</p>
  <a href={markdownUrl}>{t('docs.viewMarkdown')}</a>
  <a href={llmsUrl}>{t('docs.documentationIndex')}</a>
</aside>
