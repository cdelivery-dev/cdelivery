---
import { getCollectionPage, getSidebar, getPrevNext, getBreadcrumbs, getTOC } from '@cloudflare/nimbus-docs/runtime';
import type { SidebarItem } from '@cloudflare/nimbus-docs/types';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { components } from '../../components';
import { collections } from '../../docs/config';
import { locales } from '../../config';
import { translate } from '../../i18n';
import { docsPath } from '../../routes';

type DocsCollection = typeof collections[keyof typeof collections];
interface Props { page: Exclude<Awaited<ReturnType<typeof getCollectionPage<DocsCollection>>>, Response> }
const { entry, Content, headings, markdownUrl } = Astro.props.page;
const locale = locales.find((value) => collections[value] === entry.collection)!;
Astro.locals.docsLocale = locale;
const t = translate(locale);
const slug = entry.id === 'index' ? '' : entry.id;
const root = docsPath(locale);
const current = Astro.url.pathname.replace(/\/$/, '');
const labels: Record<string, string> = {
  accounts: t('docs.nav.accounts'),
  platform: t('docs.nav.platform'),
  logs: t('docs.nav.logs'),
  metrics: t('docs.nav.metrics'),
};
function localize(items: SidebarItem[]): SidebarItem[] {
  return items.map((item) => item.type === 'group' ? {
    ...item,
    label: labels[item.label.toLowerCase()] ?? item.label,
    collapsed: true,
    children: localize(item.children),
  } : item);
}
const sidebar = await getSidebar(current, {
  collection: entry.collection,
  transform: ({ tree }) => {
    const group = tree.find((item) => item.type === 'group' && item.segment === root.slice(0, -1));
    const children = group?.type === 'group' ? group.children : [];
    return localize([
      { type: 'link', label: t('docs.overview'), href: root, isCurrent: !slug, order: 1 },
      ...children.flatMap((item) => item.type === 'group' && ['guides', 'getting started'].includes(item.label.toLowerCase()) ? item.children : [item]),
    ]);
  },
});
const prevNext = await getPrevNext(current, { sidebarTree: sidebar });
const breadcrumbs = (await getBreadcrumbs(current, { collection: entry.collection, root: { label: t('site.nav.docs'), href: root } }))
  .filter((item) => !['guides', 'getting started'].includes(item.label.toLowerCase()))
  .map((item) => ({ ...item, label: labels[item.label.toLowerCase()] ?? item.label }));
const toc = entry.data.tableOfContents === false ? [] : getTOC(headings, entry.data.tableOfContents);
---
<DocsLayout title={entry.data.title} description={entry.data.description} locale={locale} slug={slug} markdownUrl={markdownUrl} noindex={entry.data.noindex || entry.data.draft} sidebar={sidebar} headings={toc} breadcrumbs={breadcrumbs} prevNext={prevNext}>
  <Content components={components} />
</DocsLayout>
