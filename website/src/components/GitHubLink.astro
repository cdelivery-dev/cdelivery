---
import { defaultLocale, site } from '../config';
import { translate } from '../i18n';
import Icon from './Icon.astro';
const locale = Astro.currentLocale ?? defaultLocale;
const t = translate(locale);
---
<a class="github-link" href={site.github} target="_blank" rel="noopener noreferrer" aria-label={t('site.github.repository')}>
  <span class="github-icon"><Icon name="github" size={16.4} /></span>
</a>
<style>
  .github-link { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; color: var(--color-text); text-decoration: none; }
  .github-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 15px; width: 15px; height: 18px; }
  .github-icon :global(svg) { flex: none; }
  .github-link:hover { color: var(--color-control-hover); }
  @media (width >= 800px) {
    .github-link { min-width: 0; }
  }
</style>
