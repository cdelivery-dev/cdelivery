---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import ReleaseSafety from '../components/ReleaseSafety.astro';
import Observability from '../components/Observability.astro';
import Gateway from '../components/Gateway.astro';
import Operations from '../components/Operations.astro';
import ResourceFootprint from '../components/ResourceFootprint.astro';
import SystemFlow from '../components/SystemFlow.astro';
import FAQ from '../components/FAQ.astro';
import OpenSource from '../components/OpenSource.astro';
import { translate } from '../i18n';
import '../styles/home.css';

const t = translate(Astro.currentLocale);
---
<SiteLayout title={t('site.home.title')} description={t('site.home.description')}>
  <Hero />
  <ReleaseSafety />
  <Observability />
  <Gateway />
  <Operations />
  <ResourceFootprint />
  <SystemFlow />
  <FAQ>
    <h3>{t('site.faq.kubernetes.question')}</h3>
    <p>{t('site.faq.kubernetes.answer')}</p>
    <h3>{t('site.faq.capacity.question')}</h3>
    <p>{t('site.faq.capacity.answer')}</p>
  </FAQ>
  <OpenSource />
</SiteLayout>
<script>
  import '../animation/home';
</script>
