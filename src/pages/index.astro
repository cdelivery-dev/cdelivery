---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/Hero.astro';
import ReleaseSafety from '../components/ReleaseSafety.astro';
import Observability from '../components/Observability.astro';
import Gateway from '../components/Gateway.astro';
import ResourceFootprint from '../components/ResourceFootprint.astro';
import SystemFlow from '../components/SystemFlow.astro';
import FAQ from '../components/FAQ.astro';
import OpenSource from '../components/OpenSource.astro';
import { translate } from '../i18n';
import '../styles/home.css';

const t = translate(Astro.currentLocale);
---
<SiteLayout title={t('site.home.title')} description={t('site.home.description')}>
  <Hero />
  <ReleaseSafety />
  <Observability />
  <Gateway />
  <div class="operations-overview home-section container">
    <section aria-labelledby="ai-title">
      <h2 class="section-title" id="ai-title">{t('site.ai.title')}</h2>
      <p>{t('site.ai.context')}</p>
      <p>{t('site.ai.duty')}</p>
    </section>
    <section aria-labelledby="xconfig-title">
      <h2 class="section-title" id="xconfig-title">{t('site.xconfig.title')}</h2>
      <p>{t('site.xconfig.description')}</p>
    </section>
  </div>
  <ResourceFootprint />
  <SystemFlow />
  <FAQ>
    <h3>{t('site.faq.kubernetes.question')}</h3>
    <p>{t('site.faq.kubernetes.answer')}</p>
    <h3>{t('site.faq.capacity.question')}</h3>
    <p>{t('site.faq.capacity.answer')}</p>
  </FAQ>
  <OpenSource />
</SiteLayout>
<style>
  .operations-overview { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; gap: 64px; }
  .operations-overview > section { min-width: 0; overflow-wrap: anywhere; }
  .operations-overview p { margin-top: 16px; color: var(--color-muted); }
  @media (width < 1000px) {
    .operations-overview { grid-template-columns: minmax(0, 1fr); gap: 48px; }
  }
</style>
<script>
  import '../animation/home';
</script>
