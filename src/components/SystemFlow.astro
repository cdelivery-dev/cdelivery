---
import { actors, apps, processing, settleDuration } from '../animation/flow-config';
import { defaultLocale } from '../config';
import { translate } from '../i18n';
import Icon from './Icon.astro';

const locale = Astro.currentLocale ?? defaultLocale;
const t = translate(locale);
const labels = {
  xhealth: ['XHealth', t('site.flow.xhealth')],
  pingress: ['Pingress', t('site.flow.pingress')],
  insight: ['Insight', t('site.flow.insight')],
};
---
<section class="system-flow" id="how-it-works" aria-labelledby="flow-title">
  <div class="container">
    <header class="flow-heading">
      <h2 class="section-title" id="flow-title"><span>{t('site.flow.line1')}</span>{locale.startsWith('zh') || locale === 'ja' ? '' : ' '}<span>{t('site.flow.line2')}</span></h2>
      <p class="flow-description">{t('site.flow.description')}</p>
    </header>
    <div class="flow-stage">
      <div class="flow-viewport" style={`--processing-rise:${processing.rise}s;--processing-fade:${processing.fade}s;--settle-duration:${settleDuration}s`} role="img" aria-labelledby="flow-title" aria-describedby="flow-summary flow-topology">
        <div class="flow-cluster" data-flow-cluster>
          <span class="flow-cluster-label">{t('site.flow.servers')}</span>
          {apps.map((id) => (
            <div class="flow-node flow-app" data-flow-node={id} data-flow-box={id}>
              <span class="flow-name"><span class="flow-light" aria-hidden="true" /><span>APP</span></span>
            </div>
          ))}
        </div>
        {actors.map((id) => <div class="flow-node" data-flow-box={id}><span class="flow-name">{t(`site.flow.${id}`)}</span></div>)}
        {Object.entries(labels).map(([id, label]) => (
          <div class="flow-node" data-flow-node={id} data-flow-box={id}>
            <span class="flow-name"><span>{label[0]}</span>{id === 'xhealth' && <span class="flow-check" aria-hidden="true"><Icon name="shield" /></span>}</span>
            <span class="flow-subtitle">{label[1]}</span>
          </div>
        ))}
        <canvas data-animation="flow" aria-hidden="true"></canvas>
      </div>
      <div class="flow-fallback">
        <p id="flow-summary">{t('site.flow.summary')}</p>
        <p id="flow-topology">{t('site.flow.topology')}</p>
      </div>
    </div>
  </div>
</section>
<style>
  .system-flow { container-type: inline-size; padding-bottom: 48px; }
  .flow-heading { max-width: 800px; margin-inline: auto; text-align: center; }
  .flow-heading h2 > span { display: inline-block; max-width: 100%; vertical-align: top; }
  .flow-description { margin-top: 16px; color: var(--color-muted); }
  .flow-stage { display: grid; grid-template-columns: minmax(0, 1fr); place-items: center; margin-top: 32px; }
  .flow-stage > * { grid-area: 1 / 1; min-width: 0; }
  .flow-viewport { --flow-layout: wide; --flow-space: min(1rem, 5cqi); --flow-column-gap: clamp(1.5rem, 3.333vw, 3rem); position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: auto 1fr auto 1fr auto; align-items: center; gap: var(--flow-space) var(--flow-column-gap); width: 100%; padding: calc(2 * var(--flow-space)) var(--flow-space); visibility: hidden; }
  .flow-viewport[data-ready] { visibility: visible; }
  .flow-cluster { display: grid; grid-template-rows: subgrid; grid-column: 3; grid-row: 1 / 6; align-self: stretch; align-items: center; gap: var(--flow-space); min-width: 0; padding-inline: var(--flow-space); border: 1px solid var(--color-border); border-radius: var(--flow-space); background: var(--color-surface); }
  .flow-cluster::after { content: ''; }
  .flow-cluster-label { margin-top: var(--flow-space); color: var(--color-muted); text-align: center; font-size: .75rem; font-weight: 500; line-height: 1rem; letter-spacing: .1em; overflow-wrap: anywhere; }
  .flow-node { z-index: 1; display: flex; flex-direction: column; align-items: center; align-self: center; gap: calc(var(--flow-space) / 4); min-width: 0; padding: calc(var(--flow-space) / 2) var(--flow-space); border: 1px solid #d8dde6; border-radius: calc(var(--flow-space) * .75); background: #fff; text-align: center; font-size: .875rem; line-height: 1.25rem; overflow-wrap: anywhere; hyphens: auto; transition: color var(--processing-fade) cubic-bezier(.333333, 0, .666667, 1); }
  [data-flow-box="developer"] { grid-column: 1; grid-row: 2; }
  [data-flow-box="visitor"] { grid-column: 1; grid-row: 4; }
  [data-flow-box="xhealth"] { grid-column: 2; grid-row: 2; }
  [data-flow-box="pingress"] { grid-column: 2; grid-row: 4; }
  [data-flow-box="insight"] { grid-column: 4; grid-row: 2 / 5; }
  .flow-app { --processing-fade: var(--settle-duration); border-radius: calc(var(--flow-space) / 2); }
  .flow-node[data-processing] { transition-duration: var(--processing-rise); }
  .flow-name { display: flex; justify-content: center; align-items: center; gap: calc(var(--flow-space) / 2); max-width: 100%; }
  .flow-name > span { min-width: 0; }
  .flow-app .flow-name { display: grid; grid-template-columns: calc(var(--flow-space) * .375) minmax(0, 1fr) calc(var(--flow-space) * .375); width: 100%; }
  .flow-app .flow-name::after { content: ''; }
  .flow-name, .flow-light { transition: inherit; }
  .flow-node[data-processing] :is(.flow-name, .flow-light) { color: var(--color-accent); }
  .flow-subtitle { max-width: 100%; color: var(--color-muted); font-size: .75rem; line-height: 1rem; }
  .flow-light { width: calc(var(--flow-space) * .375); height: calc(var(--flow-space) * .375); border-radius: 50%; color: #b6bfce; background: currentColor; }
  .flow-check { flex: 0 0 var(--flow-space); width: var(--flow-space); height: var(--flow-space); color: #8fb89c; }
  .flow-check :global(svg) { width: 100%; height: 100%; }
  canvas { position: absolute; z-index: 2; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .flow-fallback { width: 100%; max-width: 640px; color: var(--color-muted); text-align: center; }
  .flow-fallback p + p { margin-top: 16px; }
  .flow-viewport[data-ready] + .flow-fallback { clip-path: inset(50%); pointer-events: none; }
  @media (width < 800px) {
    .system-flow { padding-bottom: 40px; }
  }
  @container (width < 50rem) {
    .flow-stage { margin-top: 24px; }
    .flow-viewport { --flow-layout: narrow; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(4, auto); gap: calc(3 * var(--flow-space)) var(--flow-space); max-width: 28.75rem; padding: var(--flow-space); }
    .flow-cluster { grid-template-rows: auto; grid-column: 1 / -1; grid-row: 3; justify-self: center; width: min(100% - 2 * var(--flow-space), 13rem); padding: var(--flow-space); }
    .flow-cluster::after { display: none; }
    .flow-cluster-label { margin-top: 0; }
    [data-flow-box="developer"] { grid-column: 1; grid-row: 1; }
    [data-flow-box="visitor"] { grid-column: 2; grid-row: 1; }
    [data-flow-box="xhealth"] { grid-column: 1; grid-row: 2; }
    [data-flow-box="pingress"] { grid-column: 2; grid-row: 2; }
    [data-flow-box="insight"] { grid-column: 1 / -1; grid-row: 4; justify-self: center; width: min(100%, 12rem); }
  }
</style>
