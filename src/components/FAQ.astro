---
import { translate } from '../i18n';
const t = translate(Astro.currentLocale);
---
<section class="faq container" id="faq" aria-labelledby="faq-title">
  <h2 class="section-title" id="faq-title">{t('site.faq.title')}</h2>
  <slot />
</section>
<style>
  .faq { max-width: 800px; padding-top: clamp(48px, 8vw, 152px); overflow-wrap: anywhere; }
  .faq :global(h3) { margin-top: 32px; font-size: 1.125rem; line-height: 1.5; }
  .faq :global(p) { margin-top: 16px; color: var(--color-muted); font-size: .875rem; }
  .faq :global(a) { text-decoration: underline; text-underline-offset: 2px; }
  .faq :global(a:hover) { text-decoration-color: var(--color-accent); }
  @media (width < 800px) {
    .faq :global(p) { font-size: .8125rem; }
  }
</style>
