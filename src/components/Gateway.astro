---
import { defaultLocale } from '../config';
import { translate } from '../i18n';

const t = translate(Astro.currentLocale);
const intro = t('site.gateway.intro', { pingora: '__pingora__' });
const [introStart, introEnd] = intro.split('__pingora__');
const number = new Intl.NumberFormat(Astro.currentLocale ?? defaultLocale, { maximumFractionDigits: 1 });
const metrics = [
  { key: 'requests', value: 48_000, unit: 'RPS' },
  { key: 'memory', value: 688, unit: 'MiB' },
  { key: 'latency', value: 74.5, unit: 'ms' },
] as const;
---
<section class="home-columns home-section container" aria-labelledby="gateway-title">
  <header>
    <h2 class="section-title" id="gateway-title">{t('site.gateway.title')}</h2>
    <p>{introStart}<a href="https://github.com/cloudflare/pingora" target="_blank" rel="noopener noreferrer">Pingora</a>{introEnd}</p>
    <p>{t('site.gateway.operations')}</p>
  </header>
  <figure aria-labelledby="gateway-metrics-title">
    <p id="gateway-metrics-title">{t('site.gateway.metricsTitle')}</p>
    <dl class="gateway-metrics">
      {metrics.map(({ key, value, unit }) => <div class:list={{ 'gateway-primary': key === 'requests' }}>
        <dt>{t(`site.gateway.${key}Label`)}</dt>
        <dd>{number.format(value)}<span class="gateway-unit"> {unit}</span></dd>
      </div>)}
    </dl>
    <figcaption>{t('site.gateway.environment')} {t('site.gateway.note')}</figcaption>
  </figure>
</section>
<style>
  h2 { white-space: pre-line; }
  header p { margin-top: 24px; color: var(--color-muted); font-size: .9375rem; }
  header a { text-decoration: underline; text-underline-offset: 2px; }
  header a:hover { text-decoration-color: var(--color-accent); }
  figure > p, dt { color: var(--color-muted); font-size: .875rem; }
  .gateway-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin: 16px 0 0; }
  .gateway-metrics::after { content: ''; grid-column: 1 / -1; grid-row: 2; height: 1px; background: var(--color-border); }
  .gateway-metrics > div { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  dt { order: 1; }
  dd { margin: 0; color: var(--color-accent); font-size: 2rem; line-height: 1.1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .gateway-primary { grid-column: 1 / -1; }
  .gateway-primary dd { font-size: clamp(2.25rem, 4vw, 3rem); }
  .gateway-unit { color: var(--color-muted); font-size: .875rem; }
  figcaption { margin-top: 24px; color: var(--color-muted); font-size: .875rem; }
  @media (width < 360px) {
    .gateway-metrics { grid-template-columns: minmax(0, 1fr); }
  }
</style>
