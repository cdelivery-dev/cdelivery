---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale, localeDetails, locales } from '../config';
import { translate } from '../i18n';
import { unlocalizedPath } from '../routes';
import Brand from './Brand.astro';
import NavLinks from './NavLinks.astro';
import GitHubLink from './GitHubLink.astro';
import Icon from './Icon.astro';
interface Props { languageSwitchPath?: string }
const { languageSwitchPath } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const t = translate(locale);
const path = unlocalizedPath(Astro.url.pathname);
---
<header class="site-header">
  <div class="header-inner container">
    <Brand />
    <nav class="site-navigation" id="site-navigation" aria-label={t('site.header.navigation')}>
      <NavLinks />
    </nav>
    <div class="header-actions">
      <GitHubLink />
      <span class="divider" aria-hidden="true"></span>
      <details class="language-picker" name="site-menu" data-menu>
        <summary aria-label={t('site.language.select')}><span class="language-icon"><Icon name="globe" size={18} /></span><span class="dropdown-arrow"><Icon name="chevron" size={14} /></span></summary>
        <div class="language-options">
          {locales.map((target) => target === locale
            ? <span lang={target} aria-current="true">{localeDetails[target].label}<Icon name="check" size={14} /></span>
            : <a href={getRelativeLocaleUrl(target, languageSwitchPath ?? path)} lang={target} hreflang={target}>{localeDetails[target].label}</a>)}
        </div>
      </details>
      <button class="mobile-toggle" type="button" aria-label={t('site.header.toggleMenu')} aria-controls="site-navigation" aria-expanded="false">
        <span class="menu-icon"><Icon name="menu" size={22} /></span>
        <span class="close-icon"><Icon name="close" size={22} /></span>
      </button>
    </div>
  </div>
</header>
<script>
  import './header';
</script>
<style>
  .site-header { anchor-name: --site-header; position: sticky; top: 0; z-index: 50; padding-top: env(safe-area-inset-top, 0px); background: #fff; --nav-gap: clamp(16px, 2vw, 24px); --menu-easing: cubic-bezier(.22, 1, .36, 1); }
  .site-header :global(.dropdown-arrow) { display: flex; align-items: center; justify-content: center; flex: 0 0 8px; width: 8px; height: 14px; transition: transform 150ms ease-out; }
  .site-header :global(.dropdown-arrow svg) { flex: none; }
  .site-header :global(details[open] > summary .dropdown-arrow) { transform: rotate(180deg); }
  .header-inner { min-height: var(--header-height); display: flex; align-items: center; gap: var(--nav-gap); }
  .site-navigation { display: flex; align-items: center; gap: var(--nav-gap); }
  .header-actions { display: flex; align-items: center; gap: 12px; margin-left: auto; }
  .divider { width: 1px; height: 18px; background: var(--color-border); }
  summary { display: flex; align-items: center; justify-content: center; gap: 6px; list-style: none; min-height: 44px; min-width: 44px; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--color-accent); }
  .language-picker { position: relative; }
  .language-icon { display: flex; align-items: center; justify-content: center; flex: 0 0 15px; width: 15px; height: 18px; }
  .language-icon :global(svg) { flex: none; }
  .language-options { position: absolute; top: calc(100% + 8px); right: 0; z-index: 1; width: max-content; min-width: 168px; max-width: calc(100vw - 2 * var(--content-gutter)); max-height: calc(100dvh - var(--header-offset) - 24px); overflow-y: auto; padding: 6px; background: white; border: 1px solid var(--color-border); border-radius: 6px; box-shadow: var(--shadow-panel); }
  .language-options > :is(a, span) { display: flex; align-items: center; justify-content: space-between; gap: 16px; border-radius: 4px; min-height: 44px; padding: 8px 12px; font-size: .875rem; font-weight: var(--weight-nav); }
  .language-options a:hover { background: var(--color-surface); }
  .language-options [aria-current] { color: var(--color-accent); }
  .mobile-toggle { display: none; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; background: transparent; border: 0; }
  .close-icon { display: none; }
  @media (width >= 800px) {
    .header-inner { position: relative; }
    summary { min-width: 0; }
  }
  @media (width < 800px) {
    .site-header { position: static; }
    .header-inner { gap: 12px; flex-wrap: wrap; }
    .site-navigation { display: block; order: 1; width: 100%; padding-block: 12px max(24px, env(safe-area-inset-bottom, 0px)); background: #fff; }
    .site-header[data-menu-ready] { position: sticky; }
    .site-header[data-menu-ready] .header-inner { flex-wrap: nowrap; }
    .site-header[data-menu-ready] .site-navigation { display: none; position: absolute; top: 100%; left: 0; right: 0; max-height: calc(100dvh - var(--header-offset)); overflow-y: auto; padding-inline: var(--content-gutter); box-shadow: var(--shadow-panel); }
    .site-header[data-menu-ready]:has(.mobile-toggle[aria-expanded="true"]) .site-navigation { display: block; }
    .header-actions { gap: 6px; }
    .divider { display: none; }
    .site-header[data-menu-ready] .mobile-toggle { display: flex; }
    .mobile-toggle[aria-expanded="true"] .menu-icon { display: none; }
    .mobile-toggle[aria-expanded="true"] .close-icon { display: block; }
    .site-header[data-menu-ready] .header-actions { position: relative; }
    .site-header[data-menu-ready] .language-picker { position: static; }
    .language-options > :is(a, span) { font-size: 1rem; }
  }
</style>
